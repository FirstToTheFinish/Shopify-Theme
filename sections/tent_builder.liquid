{% layout none %}
<!DOCTYPE html>
<html>
<head>
  <title>FTTF Tent Builder</title>
</head>
  <link href="{{ 'test.css' | asset_url }}" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@simonwep/pickr/dist/themes/classic.min.css"/>
  {{ 'fonts.css' | asset_url | stylesheet_tag }}
<body>
<div>
    <div>
        <div>
        <div>
            <div id="loadingOverlay" class="loading-overlay">
                <div class="loading-message" id="loading-message">Generating preview, please wait...</div>
            </div>
            <div id="loadingOverlay2" class="loading-overlay">
                <div id="loading-message2" class="loading-message" style="z-index: 5; height 1100px;">Submitting Design, please wait...</div>
            </div>
        <span>
            <div id="TentDescription" class="TentHeader" style="text-align: center; line-height: 1.3;">
                <h1 style="margin: 0px;">Welcome to the Official FTTF Tent Builder!</h1>
                <p>From here you will be able to design your tent in many ways. Please use the link <a class="tent-pdf-link" href="{{ 'Tent Instructions.pdf' | asset_url }}" target="_blank" rel="noopener">HERE</a> for the instructions on using this builder. <br> For best functionality, use Google Chrome or Microsoft Edge as your browser. Other browsers may not work as expected. </p>
            </div>
            <div class="tent-builder-wrapper">
                
                <span>
                    <div class="tent-preview">
                        <div id="tent-canvases" style="margin-top:20px; position:relative;">
                            <div id="button-grid" style="display: flex; flex-direction: column; gap: 10px;">
                                <button id="toggleSnapGrid" class="snap-button">
                                    <img id="snapGrid" alt="" width="25" height="25" style="width: 25px; height: auto;">
                                    <div class="description" style="visibility: hidden;">Toggle Snap Grid</div>
                                </button>
                                <button id="horizontalCenter" class="center-button1 hidden" style="top: 35px;">
                                    <img id="horizCenter" alt="" width="25" height="25" style="width: 25px; height: auto;">
                                    <div class="description" style="visibility: hidden;">Horizontal Center</div>
                                </button>
                                <button id="verticalCenter" class="center-button2 hidden" style="top: 69px;">
                                    <img id="vertCenter" alt="" width="25" height="25" style="width: 25px; height: auto;">
                                    <div class="description" style="visibility: hidden;">Vertical Center</div>
                                </button>
                            </div>
                            <canvas id="FrontPeakCanvas" class="canvas2" style="display:block;"></canvas>
                            <div id="FrontPeakTextOverlay" class="text-overlay"></div>

                            <canvas id="FrontValanceCanvas" class="canvas2" style="display:block;"></canvas>
                            <div id="FrontValanceTextOverlay" class="text-overlay"></div>
                            <img id="ValanceLogo" width="25" height="7">

                            <canvas id="BackPeakCanvas" class="canvas2" style="display:none;"></canvas>
                            <div id="BackPeakTextOverlay" class="text-overlay"></div>

                            <canvas id="BackValanceCanvas" class="canvas2" style="display:none;"></canvas>
                            <div id="BackValanceTextOverlay" class="text-overlay"></div>

                            <canvas id="BackWallCanvas" class="canvas2" style="display:none;"></canvas>
                            <div id="BackWallTextOverlay" class="text-overlay"></div>

                            <canvas id="RightPeakCanvas" class="canvas2" style="display:none; margin-left: 90px;"></canvas>
                            <div id="RightPeakTextOverlay" class="text-overlay"></div>

                            <canvas id="RightValanceCanvas" class="canvas2" style="display:none; margin-left: 90px;"></canvas>
                            <div id="RightValanceTextOverlay" class="text-overlay"></div>

                            <canvas id="RightWallCanvas" class="canvas2" style="display:none; margin-left: 90px;"></canvas>
                            <div id="RightWallTextOverlay" class="text-overlay"></div>

                            <canvas id="LeftPeakCanvas" class="canvas2" style="display:none; margin-left: 90px;"></canvas>
                            <div id="LeftPeakTextOverlay" class="text-overlay"></div>

                            <canvas id="LeftValanceCanvas" class="canvas2" style="display:none; margin-left: 90px;"></canvas>
                            <div id="LeftValanceTextOverlay" class="text-overlay"></div>

                            <canvas id="LeftWallCanvas" class="canvas2" style="display:none; margin-left: 90px;"></canvas>
                            <div id="LeftWallTextOverlay" class="text-overlay"></div>

                            <canvas id="tentPreviewCanvas" width="650" height="400" style="display: none; margin-left: -60px;"></canvas>
                            <img id="tentPreviewImage" width="650" height="400" style="display: none; margin-left: -70px; transform: scale(1.5); margin-top: 20px;" />
                            <img id="ValanceLogo2" alt="" width="25" height="7" style="display:none; visibility: hidden;">
                        </div>
                    </div>
                </span>
                <span>
                    <div>
                            <script>
                                var itDescript = "10x20";
                                var higherPrice = "$1,889.00";
                                var itType = true;
                                var tentTitle;
                                var pricing = `Total Price: ${higherPrice}`;

                                if(itType){
                                    tentTitle = `Custom ${itDescript} Tent Value Pack`;
                                }
                                else{
                                    tentTitle = `Fully Custom ${itDescript} Tent`;
                                }

                                document.addEventListener("DOMContentLoaded", function () {
                                    document.getElementById("tentTitle").textContent = tentTitle;
                                });

                                document.addEventListener("DOMContentLoaded", function () {
                                    document.getElementById("pricing").textContent = pricing;
                                });
                            </script>
                    </div>
                    <div class="tent-controls">                      
                        <div style="position:relative">
                            <h4 id="tentTitle"></h4>
                            <span id="infoTitle" style="display: none"></span>
                            <p id ="pricing" style="font-size: 20px; margin-top:-15px;"></p>
                            <button type="button" id="tent-setup-button" class="btn btn--primary w-full" style="margin-bottom: 20px;" onclick="toggleTentSettingsMenu()">
                                ⚙️ Tent Setup Options
                            </button>
                            <div id="tent-settings-menu" class="tent-settings-panel" style="display: none;">
                                <button class="close-button" onclick="toggleTentSettingsMenu()" aria-label="Close">
                                    &times;
                                </button>
                                <div class="settings-group">
                                    <label class="font-style-label">Tent Size:</label>
                                    <div class="button-radio-group" id="tent-size-options">
                                      <label class="square-radio">
                                        <input type="radio" name="tent-size" value="10x10" onchange="updateTentPricing()">
                                        <span id="price-10x10">10'x10'</span>
                                      </label>
                                      <label class="square-radio">
                                        <input type="radio" name="tent-size" value="10x15" onchange="updateTentPricing()">
                                        <span id="price-10x15">10'x15'</span>
                                      </label>
                                      <label class="square-radio">
                                        <input type="radio" name="tent-size" value="10x20" checked onchange="updateTentPricing()">
                                        <span id="price-10x20">10'x20'</span>
                                      </label>
                                    </div>
                                  </div>
                                  
                                                                    
                              
                                <div class="settings-group">
                                    <label class="font-style-label">Frame Type:</label>
                                    <div class="button-radio-group" id="frame-type-options">
                                      <label class="square-radio">
                                        <input type="radio" name="frame-type" value="aluminum" checked onchange="updateFramePricing()">
                                        <span id="frame-aluminum-label">Aluminum</span>
                                      </label>
                                      {% comment %} <label class="square-radio">
                                        <input type="radio" name="frame-type" value="steel" onchange="updateFramePricing()">
                                        <span id="frame-steel-label">Steel (+$100.00)</span>
                                      </label> {% endcomment %}
                                    </div>
                                </div>                                  
                              
                                <div class="settings-group">
                                    <label class="font-style-label">Walls Present:</label>
                                    <label>
                                      <input type="radio" name="walls-present" value="yes" checked onchange="updateTentPricing()">
                                      <span id="wall-yes-label">Yes</span>
                                    </label>
                                    <label>
                                      <input type="radio" name="walls-present" value="no" onchange="updateTentPricing()">
                                      <span id="wall-no-label">No</span>
                                    </label>
                                </div>

                                <div class="settings-group">
                                    <label class="font-style-label">Total Price:</label>
                                    <div id="total-price" style="font-weight: bold; font-size: 16px;">$1,889</div>
                                </div>
                                                                   
                                <button id="save-button" class="btn btn--primary w-half" onclick="saveTentSettings()" style="margin-top: 15px;">
                                    Save Changes
                                </button>
                                
                            </div>                                                           
                            <div id="file-upload-modal" class="modal">
                                <div class="modal-content">
                                    <span class="close-button" onclick="closeUploadModal()">&times;</span>
                                    <div class="modal-header">
                                        <h2>CHOOSE ANOTHER FILE</h2>
                                    </div>
                                    <div class="modal-body">
                                        <p>File extension error. Only jpeg, jpg, png, and svg images are allowed.</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button class="ok-button" onclick="closeUploadModal()">OK</button>
                                    </div>
                                </div>
                            </div>
                            <div id="required-fields-modal" class="modal">
                                <div class="modal-content">
                                    <span class="close-button" onclick="closeRequiredFieldsModal()">&times;</span>
                                    <div class="modal-header">
                                        <h2>REQUIRED FIELDS</h2>
                                    </div>
                                    <div class="modal-body">
                                        <p>Please complete all required fields presented with a red outline and/or says *REQUIRED.</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button class="ok-button" onclick="closeRequiredFieldsModal()">OK</button>
                                    </div>
                                </div>
                            </div>
                            <div id="sections-container"></div>                       
                        </div>
                    </div>
                </span>
            </div>
        </span>
    </div>
</div>
</div>
</div>
    <script>
        window.shopifyAssetPaths = {
            logos: {
                blackValance: "{{ 'fttf black logo for valnce TENT.svg' | asset_url }}",
                whiteValance: "{{ 'fttf white logo for valnce TENT.svg' | asset_url }}",
                pdfLogo: "{{ 'fttf black logo for valnce TENT.png' | asset_url }}"
              },
            grid: {
                horizontalCenter: "{{ 'horizontal-center.png' | asset_url }}",
                horizontalCenterWhite: "{{ 'horizontal_center_white.png' | asset_url }}",
                verticalCenter: "{{ 'vertical-center.png' | asset_url }}",
                verticalCenterWhite: "{{ 'vertical-center_white.png' | asset_url }}",
                snapGrid: "{{ 'snap-grid.png' | asset_url }}",
                snapGridWhite: "{{ 'snap-grid_white.png' | asset_url }}"
              },
            tools: {
                uploadIcon: "{{ 'upload.png' | asset_url }}",
                eyeDropper: "{{ 'OIP.jfif' | asset_url }}",
                tentPDF: "{{ 'Tent Instructions.pdf' | asset_url }}"
              },
            tentColors: {
                "Black": "{{ 'BLACK.svg' | asset_url }}",
                "Cardinal": "{{ 'CARDINAL.svg' | asset_url }}",
                "Columbia Blue": "{{ 'COLUMBIA BLUE.svg' | asset_url }}",
                "Forest Green": "{{ 'FOREST GREEN.svg' | asset_url }}",
                "Grey": "{{ 'GREY.svg' | asset_url }}",
                "Kelly Green": "{{ 'KELLY GREEN.svg' | asset_url }}",
                "Maroon": "{{ 'MAROON.svg' | asset_url }}",
                "Navy Blue": "{{ 'NAVY BLUE.svg' | asset_url }}",
                "Orange": "{{ 'ORANGE.svg' | asset_url }}",
                "Purple": "{{ 'PURPLE.svg' | asset_url }}",
                "Red": "{{ 'RED.svg' | asset_url }}",
                "Royal Blue": "{{ 'ROYAL BLUE.svg' | asset_url }}",
                "Silver": "{{ 'SILVER.svg' | asset_url }}",
                "Vegas Gold": "{{ 'VEGAS GOLD.svg' | asset_url }}",
                "White": "{{ 'WHITE.svg' | asset_url }}",
                "Yellow Gold": "{{ 'YELLOW GOLD.svg' | asset_url }}",
                "Yellow": "{{ 'YELLOW.svg' | asset_url }}",
            }

        };
        document.getElementById('snapGrid').src = window.shopifyAssetPaths.grid.snapGrid;
        document.getElementById('horizCenter').src = window.shopifyAssetPaths.grid.horizontalCenter;
        document.getElementById('vertCenter').src = window.shopifyAssetPaths.grid.verticalCenter;
        document.getElementById('ValanceLogo').src = window.shopifyAssetPaths.grid.blackValance;
        document.getElementById('ValanceLogo2').src = window.shopifyAssetPaths.grid.blackValance;

    </script>
    <script src="https://cdn.jsdelivr.net/npm/@simonwep/pickr/dist/pickr.min.js" defer></script>
    <script src="{{ 'tent-canvas.js' | asset_url }}" defer></script>
    <script src="{{ 'tent_sections_config.js' | asset_url }}" defer></script>
    <script src="{{ 'tent_generate_sections.js' | asset_url }}" defer></script>
    <script src="{{ 'tent_update_section.js' | asset_url }}" defer></script>
    <script src="{{ 'tent-preview.js' | asset_url }}" defer></script>
    <script src="{{ 'tent_update_text.js' | asset_url }}" defer></script>
    <script src="{{ 'tent_update_art.js' | asset_url }}" defer></script>
    <script src="{{ 'tent_generate_pdf.js' | asset_url }}" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer></script>
    <script src="https://unpkg.com/pdf-lib/dist/pdf-lib.js" defer></script>
</body>
</html>
